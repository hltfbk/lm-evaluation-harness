dataset_path: evalitahf/gsi_detect
dataset_kwargs:
  revision: bb0315c1fe01eb13e7eb333aa43d9c3bf9b5bed8
dataset_name: default
test_split: test
validation_split: dev
fewshot_split: dev_fewshot
fewshot_config:
  sampler: first_n
doc_to_target: !function gsi_utils.gsi_task1_doc_to_target
process_results: !function gsi_utils.gsi_task1_process_results
output_type: generate_until
target_delimiter: " "
generation_kwargs:
  until:
    - "</s>"
  do_sample: false
  max_gen_toks: 256
metric_list:
  - metric: gsi_mse
    aggregation: !function gsi_utils.aggregate_gsi_mse
    higher_is_better: false
  - metric: gsi_mse_score
    aggregation: !function gsi_utils.aggregate_gsi_mse_score
    higher_is_better: true
  - metric: gsi_nmse
    aggregation: !function gsi_utils.aggregate_gsi_nmse
    higher_is_better: false
  - metric: gsi_nmse_score
    aggregation: !function gsi_utils.aggregate_gsi_nmse_score
    higher_is_better: true
  - metric: gsi_ccc
    aggregation: !function gsi_utils.aggregate_gsi_ccc
    higher_is_better: true
metadata:
  version: 1
